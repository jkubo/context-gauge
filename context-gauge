#!/usr/bin/env python3
"""context-gauge — multi-harness saturation gauge (Claude Code + Grok Build).

One self-contained, dependency-free script (Python 3 stdlib only) that works as
BOTH integration points, dispatched automatically on the stdin it receives:

  • a **statusLine** command — renders an ANSI-colored ⛽ band
    (🟢 GREEN / 🟡 YELLOW / 🟠 ORANGE / 🔴 RED / ⚫ BLACK) that tracks how full
    your reasoning working set is, visible at a glance in the status bar; and

  • a **UserPromptSubmit hook** — injects a one-line ⛽ CONTEXT FUEL reading into
    the model's context each turn, so the model itself can decide when to split /
    scope down / hand off (you can't *feel* saturation; the number doesn't lie).

WHAT IT MEASURES — WORKING SET, NOT RAW FILL. Every Claude Code session is born
tens of thousands of tokens deep just from the harness system prompt + tool
schemas + any always-injected files (CLAUDE.md, memory, etc.). That floor is
cached, position-privileged, and NOT what the model actively reasons over — so
banding raw fill would flag every fresh session as "degraded" on turn 1
(cry-wolf). Instead this bands the WORKING SET:

    working = current_fill − session_floor

where session_floor = the fill of the FIRST assistant turn (the harness floor)
and current_fill = input + cache_read + cache_creation of the LATEST assistant
turn. This self-calibrates per project (a lean repo and a heavy one land at
comparable readings) so the band tracks the reasoning working set — the thing
that actually degrades.

WHY ABSOLUTE TOKENS, NOT % OF WINDOW. Long-context degradation onset is roughly
window-independent (NoLiMa: <50% of baseline by ~32K task tokens on models
advertised at 128K–1M; Chroma "Context Rot": a 200K model degrades around ~50K;
Lost-in-the-Middle U-curve). A bigger window adds room to OVERFLOW the effective
span, not to extend it. So the band is absolute working-set tokens; the window
only feeds a secondary auto-compaction-proximity % (cosmetic — band correctness
does not depend on it).

CONFIG (all optional; env vars):
  CLAUDE_CONTEXT_GAUGE_DISABLE   any truthy value → no-op, fail-open (kill switch)
  CLAUDE_CONTEXT_GAUGE_WINDOW    context window in tokens for the % (default 200000;
                                 set 1000000 if you run the 1M-context beta)

FAIL-OPEN, ALWAYS. Any error, missing data, or disable → emit nothing (hook) or a
minimal/blank bar (statusLine) and exit 0. A UserPromptSubmit hook must NEVER
exit non-zero: exit 2 erases the user's prompt. A crashing statusLine would wreck
the bar. Both paths are wrapped to always exit 0.

TEST:
  claude-context-gauge --self-test              # print all five bands
  claude-context-gauge --transcript FILE.jsonl  # render both modes for a transcript
"""
import json
import os
import sys

# --- Band thresholds — ABSOLUTE WORKING-SET tokens (fill − floor) --------------
# Anchors: NoLiMa reasoning onset ~32K task tokens; a fresh coherent working set
# holds a little longer than NoLiMa's adversarial needle, so GREEN < 40K. RED
# 150–250K working ≈ ~205–305K total fill once a ~55–66K harness floor is added
# back — i.e. the ~200K native-reliability boundary. BLACK ≥ 250K working ≈ ~305K+
# total: ~50% past that boundary, where reasoning is unreliable and the next
# fan-out risks tripping lossy auto-compaction. RED = "at the limit"; BLACK =
# "past it — stop". Tune to taste; keep any doc/table you publish in sync.
GREEN_MAX = 40_000
YELLOW_MAX = 90_000
ORANGE_MAX = 150_000
RED_MAX = 250_000

DEFAULT_WINDOW = 200_000  # standard Claude Code context window; override via env for 1M beta
MAX_SCAN_BYTES = 64 * 1024 * 1024  # above this, degrade to head+tail instead of a full pass

# band -> (ceiling, name, emoji, one-line action for the injected reading)
BANDS = [
    (GREEN_MAX,  "GREEN",  "\U0001F7E2", "full reasoning capacity"),
    (YELLOW_MAX, "YELLOW", "\U0001F7E1", "prefer delegating searches; scope new inputs deliberately"),
    (ORANGE_MAX, "ORANGE", "\U0001F7E0", "split before reading; take on no new large reasoning input; checkpoint soon"),
    (RED_MAX,    "RED",    "\U0001F534", "handoff imminent — finish only what's in hand; take on no new reasoning load (reasoning materially degraded)"),
    (float("inf"), "BLACK", "⚫", "STOP — hand off to a fresh session NOW; the next fan-out risks tripping lossy auto-compaction (reasoning unreliable)"),
]

# band -> ANSI SGR. ORANGE uses 256-color 208 (no basic orange); RED is bold red;
# BLACK is bold bright-white ON red — a full alarm bar (plain black would be
# invisible on a dark terminal). A terminal that ignores a code degrades to plain
# text, never breaks.
_ANSI = {"GREEN": "\033[32m", "YELLOW": "\033[33m",
         "ORANGE": "\033[38;5;208m", "RED": "\033[1;31m",
         "BLACK": "\033[1;97;41m"}
_RESET = "\033[0m"
_DIM = "\033[2m"
_SEP = f" {_DIM}·{_RESET} "


def _disabled():
    return bool(os.environ.get("CLAUDE_CONTEXT_GAUGE_DISABLE"))


def _window():
    try:
        return int(os.environ.get("CLAUDE_CONTEXT_GAUGE_WINDOW", DEFAULT_WINDOW))
    except (TypeError, ValueError):
        return DEFAULT_WINDOW


def _fmt_k(n):
    return f"{n/1000:.0f}K" if n < 1_000_000 else f"{n/1_000_000:.2f}M"


def band_for(working):
    for ceiling, name, emoji, action in BANDS:
        if working < ceiling:
            return name, emoji, action
    return BANDS[-1][1], BANDS[-1][2], BANDS[-1][3]


def _is_main_assistant_usage(obj):
    """Return the usage dict for a MAIN-window assistant turn, else None.

    Sub-agent (sidechain) and meta lines live in a different window and must be
    skipped, or a fat sub-agent turn would spike the main-session reading.
    """
    if obj.get("isSidechain") or obj.get("isMeta"):
        return None
    msg = obj.get("message") or {}
    usage = msg.get("usage")
    if usage and (msg.get("role") == "assistant" or obj.get("type") == "assistant"):
        return usage
    return None


def scan_usage(transcript_path):
    """One streaming pass → (first_usage, last_usage) of MAIN assistant turns.

    Full-file by default so it can't go blind when the newest usage line sits far
    from EOF (e.g. right after a multi-MB tool result). Degrades to head+tail only
    for pathologically huge transcripts (> MAX_SCAN_BYTES).
    """
    try:
        size = os.path.getsize(transcript_path)
    except OSError:
        return None, None

    first = last = None
    try:
        if size <= MAX_SCAN_BYTES:
            with open(transcript_path, "rb") as f:
                for raw in f:
                    if b'"usage"' not in raw:
                        continue
                    try:
                        obj = json.loads(raw)
                    except (ValueError, UnicodeDecodeError):
                        continue
                    u = _is_main_assistant_usage(obj)
                    if u is not None:
                        if first is None:
                            first = u
                        last = u
        else:
            # degraded: head for the floor, tail for the current reading
            with open(transcript_path, "rb") as f:
                head = f.read(1_000_000)
                f.seek(size - 4_000_000)
                f.readline()
                tail = f.read()
            for raw in head.splitlines():
                if b'"usage"' in raw:
                    try:
                        u = _is_main_assistant_usage(json.loads(raw))
                    except (ValueError, UnicodeDecodeError):
                        u = None
                    if u is not None:
                        first = u
                        break
            for raw in reversed(tail.splitlines()):
                if b'"usage"' in raw:
                    try:
                        u = _is_main_assistant_usage(json.loads(raw))
                    except (ValueError, UnicodeDecodeError):
                        u = None
                    if u is not None:
                        last = u
                        break
    except (OSError, ValueError):
        return None, None
    return first, last


def compute_fill(usage):
    """Context fill = everything the model reads on input; output tokens excluded."""
    return (
        int(usage.get("input_tokens", 0) or 0)
        + int(usage.get("cache_read_input_tokens", 0) or 0)
        + int(usage.get("cache_creation_input_tokens", 0) or 0)
    )


def reading(transcript_path):
    """Return (working, total, floor) or None if there's nothing to report yet."""
    first, last = scan_usage(transcript_path)
    if last is None:
        return None  # no assistant turn yet — say nothing
    total = compute_fill(last)
    floor = compute_fill(first) if first is not None else 0
    working = max(0, total - floor)
    return working, total, floor


# --- Grok: signals.json reading -------------------------------------------------

def reading_grok_signals(sig, session_id):
    """Extract working set from Grok signals.json (contextTokensUsed, primaryModelId)."""
    total = int(sig.get("contextTokensUsed") or 0)
    if total <= 0:
        return None
    window = int(sig.get("contextWindowTokens") or 0) or 500_000  # Grok's typical window
    # For Grok, use the session's first CompletionUsage as floor (if saved)
    floor = _load_grok_floor(session_id, total)
    working = max(0, total - floor)
    model = sig.get("primaryModelId") or "grok"
    return working, total, floor, window, model


def _grok_floor_path(session_id):
    """Cache Grok floor on disk to survive restarts."""
    import re
    # Sanitize session_id to prevent path traversal
    if not re.match(r'^[a-zA-Z0-9_\-]{1,128}$', str(session_id or "")):
        return None
    cache_dir = os.path.expanduser(
        os.environ.get("CONTEXT_GAUGE_FLOOR_DIR", "~/.context-gauge/floors")
    )
    os.makedirs(cache_dir, mode=0o700, exist_ok=True)
    return os.path.join(cache_dir, f"{session_id}.json")


def _load_grok_floor(session_id, total):
    """Load cached floor, or seed with current total if new session."""
    try:
        path = _grok_floor_path(session_id)
        if not path:
            return total
        with open(path) as f:
            data = json.load(f)
            return int(data.get("floor", total))
    except (OSError, ValueError, KeyError):
        _save_grok_floor(session_id, total)
        return total


def _save_grok_floor(session_id, floor):
    """Save floor to disk for next session."""
    try:
        path = _grok_floor_path(session_id)
        if not path:
            return
        with open(path, "w") as f:
            json.dump({"floor": floor}, f)
            os.chmod(path, 0o600)
    except OSError:
        pass


def emit_hook_grok(working, total, floor, window, model):
    """Emit Grok-compatible JSON with accurate working set."""
    name, _emoji, action = band_for(working)
    sys.stdout.write(json.dumps({
        "hookSpecificOutput": {
            "hookEventName": "UserPromptSubmit",
            "additionalContext": (
                f"⛽ CONTEXT FUEL {_fmt_k(working)} working set ({name}) "
                f"[{_fmt_k(total)} total − {_fmt_k(floor)} floor] "
                f"· {total/window*100:.0f}% of {_fmt_k(window)} window "
                f"· reasoning: {action}."
            ),
        }
    }))


# --- UserPromptSubmit hook: the injected ⛽ CONTEXT FUEL reading ----------------

def gauge_line(working, total, floor):
    name, emoji, action = band_for(working)
    window = _window()
    pct = total / window * 100 if window else 0
    compaction = " · compaction near ⚠" if pct >= 80 else ""
    return (
        f"⛽ CONTEXT FUEL {_fmt_k(working)} working set ({emoji} {name}) "
        f"[{_fmt_k(total)} total − {_fmt_k(floor)} floor] "
        f"· {pct:.0f}% of {_fmt_k(window)} window{compaction} "
        f"· reasoning: {action}. "
        f"[bands: \U0001F7E2<{_fmt_k(GREEN_MAX)} \U0001F7E1<{_fmt_k(YELLOW_MAX)} "
        f"\U0001F7E0<{_fmt_k(ORANGE_MAX)} \U0001F534<{_fmt_k(RED_MAX)} ⚫≥{_fmt_k(RED_MAX)}; "
        f"mechanical/retrieval work gets ~2-3× headroom]"
    )


def emit_hook(text):
    sys.stdout.write(json.dumps({
        "hookSpecificOutput": {
            "hookEventName": "UserPromptSubmit",
            "additionalContext": text,
        }
    }))


# --- statusLine: the ANSI-colored band segment ---------------------------------

def band_segment(working):
    """The colored ⛽ band segment for the status bar (no model/suffix)."""
    name, emoji, _action = band_for(working)
    color = _ANSI.get(name, "")
    seg = f"{color}⛽ {emoji} {name} {_fmt_k(working)}{_RESET}"
    if name == "BLACK":
        seg += f" {color}⚑ HANDOFF NOW{_RESET}"       # past RED — stop, don't push the next fan-out
    elif name in ("ORANGE", "RED"):
        seg += f" {color}⚑ handoff soon{_RESET}"
    return seg


def statusline(transcript_path, model=""):
    tail = model or ""
    if _disabled():
        return tail
    suffix = (_SEP + tail) if tail else ""
    r = reading(transcript_path) if transcript_path else None
    if r is None:  # no assistant turn yet — neutral, don't fake a band
        return f"{_DIM}⛽ …{_RESET}{suffix}"
    working, _total, _floor = r
    return band_segment(working) + suffix


# --- dual-mode dispatch --------------------------------------------------------

def main():
    args = sys.argv[1:]

    # --- test / CLI paths (bypass stdin) ---
    if "--self-test" in args:
        floor = 60_000
        for working in (10_000, 60_000, 120_000, 200_000, 300_000):
            print(f"bar   : {band_segment(working)}")
            print(f"inject: {gauge_line(working, working + floor, floor)}")
            print()
        return 0
    if "--transcript" in args:
        i = args.index("--transcript") + 1
        if i >= len(args):
            print("usage: --transcript <file.jsonl>", file=sys.stderr)
            return 0  # stay fail-open even on the CLI path
        r = reading(args[i])
        if r is None:
            print("(no assistant usage found)", file=sys.stderr)
            return 0
        print("hook  :", gauge_line(*r))
        print("status:", statusline(args[i], model="claude"))
        return 0

    # --- live path: read stdin, detect Grok vs Claude, dispatch, FAIL-OPEN, always exit 0 ---
    try:
        data = json.load(sys.stdin)
    except Exception:
        print("")
        return 0

    # Detect Grok vs Claude from stdin shape
    is_grok = bool(data.get("sessionId") or data.get("workspaceRoot"))
    is_hook = data.get("hook_event_name") == "UserPromptSubmit" or data.get("hookEventName") == "UserPromptSubmit"

    if is_grok:
        # Grok path: signals.json + floor cache
        try:
            if _disabled():
                return 0
            sig = data.get("signal") or {}
            sid = data.get("sessionId") or ""
            if not sig or not sid or not _grok_floor_path(sid):  # reject invalid sessionId
                return 0
            r = reading_grok_signals(sig, sid)
            if r is None:
                return 0
            if is_hook:
                emit_hook_grok(*r)
            else:
                # Grok has no statusLine, only hook
                pass
        except Exception:
            pass
        return 0

    # Claude path: transcript.jsonl (unchanged, preserves emoji)
    tp = data.get("transcript_path", "")

    if is_hook:
        try:
            if _disabled() or not tp:
                return 0
            r = reading(tp)
            if r is None:
                return 0
            emit_hook(gauge_line(*r))
        except Exception:
            pass  # never wedge a prompt
        return 0

    # Claude statusLine mode
    try:
        model = (data.get("model") or {}).get("display_name", "")
        print(statusline(tp, model))
    except Exception:
        try:
            print("")  # a blank bar beats a traceback
        except Exception:
            pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
