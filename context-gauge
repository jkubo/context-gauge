#!/usr/bin/env sh
# context-gauge — clone-UX wrapper.
#
# THE IMPLEMENTATION LIVES IN context_gauge.py. Keep it that way.
# This file was once a full second copy of the script; the two drifted, and the
# installed copy lost Grok support while the packaged copy lost the Claude
# status bar. One implementation means one place to fix a bug.
#
# install.sh installs context_gauge.py directly as ~/.local/bin/context-gauge,
# so this wrapper only runs for people executing it out of a clone.
DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -f "$DIR/context_gauge.py" ]; then
  exec python3 "$DIR/context_gauge.py" "$@"
fi
if command -v context-gauge >/dev/null 2>&1 && [ "$(command -v context-gauge)" != "$0" ]; then
  exec context-gauge "$@"
fi
echo "context-gauge: context_gauge.py not found next to $0" >&2
exit 0
